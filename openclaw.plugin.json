{
  "id": "hookdeck",
  "name": "Hookdeck",
  "description": "Reliable webhooks for OpenClaw. Verified, deduplicated and retryable event delivery via the Hookdeck Event Gateway.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "hookdeck_doctor",
      "hookdeck_inspect_event",
      "hookdeck_issues",
      "hookdeck_pause",
      "hookdeck_recent_deliveries",
      "hookdeck_replay",
      "hookdeck_setup",
      "hookdeck_status"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "signingSecret",
          "expected": "string",
          "ownerKind": "plugin"
        },
        {
          "path": "routes.*.signingSecret",
          "expected": "string",
          "ownerKind": "route"
        },
        {
          "path": "apiKey",
          "expected": "string",
          "ownerKind": "plugin"
        },
        {
          "path": "routes.*.verification.credentials.*",
          "expected": "string",
          "ownerKind": "route"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "description": "Hookdeck API key. Optional \u2014 without it the plugin runs ingress-only: verification, deduplication and dispatch all work, but work interrupted by a crash cannot be re-queued.",
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "provider",
              "id"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec"
                ]
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "busyRetryAfterSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 10,
        "description": "Retry-After sent when deferring a delivery at capacity."
      },
      "catchUp": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Replay requests that arrived while no listener was attached."
          },
          "minGapSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "default": 30,
            "description": "Below this, an outage is not worth a bulk replay."
          },
          "heartbeatSeconds": {
            "type": "integer",
            "default": 30,
            "description": "How often to record that the gateway is alive, so a crash that never ran its shutdown is still detectable as an outage."
          }
        }
      },
      "dedupe": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ttlHours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 720,
            "default": 168,
            "description": "Ledger retention. Must exceed Hookdeck's one-week automatic retry ceiling."
          }
        }
      },
      "deferAttemptLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 5,
        "description": "Deferrals of the same event before the short Retry-After is dropped and exponential backoff takes over."
      },
      "headerPrefix": {
        "type": "string",
        "minLength": 1,
        "default": "x-hookdeck",
        "description": "Prefix for Hookdeck's delivery headers. White-labelable per Hookdeck project, so read from config rather than assumed."
      },
      "ingress": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "basePath": {
            "type": "string",
            "minLength": 1,
            "default": "/hookdeck",
            "description": "Gateway route prefix. May not be '/'."
          }
        }
      },
      "maxConcurrent": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 4,
        "description": "Local admission control. In CLI transport this is the only limit, since CLI destinations carry no rate_limit field."
      },
      "pause": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "onShutdown": {
            "type": "boolean",
            "default": true,
            "description": "Pause the connection before stopping the listener, so events are held at HOLD rather than discarded. A clean CLI shutdown otherwise forfeits the server's grace window."
          },
          "shutdownTimeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "default": 5000
          }
        }
      },
      "projectId": {
        "type": "string",
        "description": "Pins API calls to one Hookdeck project via X-Team-Id. Optional for a project-scoped API key, which implies its project; needed for an organisation-scoped one."
      },
      "provisioning": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Upsert Hookdeck connections at startup. Requires apiKey."
          },
          "force": {
            "type": "boolean",
            "default": false,
            "description": "Re-upsert even when the computed spec is unchanged."
          },
          "dedupeWindowMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400000,
            "description": "Native Hookdeck dedupe window, so a double-firing provider costs one run."
          }
        }
      },
      "recovery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "On startup, re-queue work interrupted by a crash by calling POST /events/{id}/retry for every running ledger row owned by a dead process instance. Requires apiKey."
          },
          "maxEvents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 50,
            "description": "Caps a crash loop from storming the Hookdeck API. Oldest events are recovered first."
          }
        }
      },
      "routes": {
        "type": "object",
        "description": "Map of routeId -> route. Each route is served at <ingress.basePath>/<path>.",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "dispatch"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "path": {
              "type": "string",
              "description": "Path segment appended to ingress.basePath. Defaults to '/<routeId>'."
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "Hookdeck source name. Required \u2014 'hookdeck listen' takes it as a positional argument and forwards exactly one source per process."
            },
            "connectionId": {
              "type": "string",
              "minLength": 1,
              "description": "Hookdeck connection id. Only needed when provisioning is disabled: pause-on-shutdown and catch-up both act on a connection, and without an id they are silently inert."
            },
            "signingSecret": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "provider",
                    "id"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": [
                        "env",
                        "file",
                        "exec"
                      ]
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "verification": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "credentials"
              ],
              "description": "Provider signature verification, applied by Hookdeck at the Source. This is a THIRD-PARTY secret (Stripe's whsec_..., GitHub's webhook secret), not the same as signingSecret which is Hookdeck's own. The plugin never verifies it \u2014 Hookdeck rejects unverified requests before an event is created.",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Hookdeck source auth type, e.g. STRIPE, GITHUB, SHOPIFY."
                },
                "credentials": {
                  "type": "object",
                  "description": "Provider-specific credential fields, each an inline string or a secretRef.",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "properties": {
                          "source": {
                            "type": "string",
                            "enum": [
                              "env",
                              "file",
                              "exec"
                            ]
                          },
                          "provider": {
                            "type": "string",
                            "minLength": 1
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "dispatch": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "sessionKey"
                  ],
                  "properties": {
                    "mode": {
                      "const": "wake"
                    },
                    "sessionKey": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Session the system event is enqueued against. Required \u2014 enqueueSystemEvent throws without one."
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "description": "System event text. Placeholders: {source}, {eventId}, {routeId}."
                    },
                    "wakeMode": {
                      "type": "string",
                      "enum": [
                        "now",
                        "next-heartbeat"
                      ],
                      "default": "now",
                      "description": "'now' also requests an immediate heartbeat; 'next-heartbeat' only enqueues."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "sessionKey"
                  ],
                  "properties": {
                    "mode": {
                      "const": "taskflow"
                    },
                    "sessionKey": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Session the flows are bound to. Flow state is scoped to it."
                    },
                    "controllerId": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Identifies flows this route manages. Defaults to hookdeck/<routeId>."
                    },
                    "allowedActions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "enum": [
                          "get_flow",
                          "list_flows",
                          "find_latest_flow",
                          "resolve_flow",
                          "get_task_summary",
                          "create_flow",
                          "run_task",
                          "set_waiting",
                          "resume_flow",
                          "finish_flow",
                          "fail_flow",
                          "request_cancel",
                          "cancel_flow"
                        ]
                      },
                      "description": "When set, only these actions are accepted on this route."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "sessionKey",
                    "prompt"
                  ],
                  "properties": {
                    "mode": {
                      "const": "agent"
                    },
                    "sessionKey": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Supports {routeId}, {eventId}, {source}; sanitised to a safe alphabet."
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Prompt template. Placeholders such as {{payload.type}} are substituted as JSON, never as bare prose, so a payload cannot break out into instruction position."
                    },
                    "ackMode": {
                      "type": "string",
                      "enum": [
                        "async_retry",
                        "sync"
                      ],
                      "default": "async_retry",
                      "description": "async_retry acknowledges 202 and runs in the background, asking Hookdeck to redeliver on failure. sync holds the response, degrading to 202 on timeout."
                    },
                    "syncTimeoutSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3600,
                      "default": 45
                    },
                    "maxAgentRetries": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 50,
                      "default": 3,
                      "description": "Redeliveries requested after a failed run before the event is marked exhausted."
                    },
                    "deliver": {
                      "type": "boolean",
                      "default": false,
                      "description": "Whether the agent's reply is delivered to a messaging channel. Off by default: a webhook-triggered route must not send anything outbound, or an injected payload gains a way out."
                    },
                    "lane": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "filters": {
              "type": "array",
              "description": "Payload filters; all must pass. A non-match is answered 200, since the drop is deliberate. Prefer filtering at the Hookdeck connection where you can.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Dotted path into the payload."
                  },
                  "equals": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "in": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "exists": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "safety": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowRetryCancel": {
            "type": "boolean",
            "default": false,
            "description": "Permit 'Retry-After: -1' to cancel Hookdeck's automatic retries on permanently-invalid input. Off by default: with it off, wire behaviour matches Hookdeck's other agent-platform plugins exactly."
          }
        }
      },
      "signingSecret": {
        "description": "Default Hookdeck signing secret (Settings -> Project -> Secrets). Routes may override.",
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "provider",
              "id"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec"
                ]
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "storage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Persist the ledger and dead-letter log under the plugin state directory. Off means memory-only: exactly-once within a process, at-least-once across a restart, and no crash recovery."
          },
          "deadLetterMaxEntries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "default": 500,
            "description": "Dead-letter entries retained before the oldest are dropped."
          }
        }
      },
      "tools": {
        "type": "object",
        "additionalProperties": false,
        "description": "Agent-facing tool surface.",
        "properties": {
          "allowMutations": {
            "type": "boolean",
            "default": true,
            "description": "When false, the agent can diagnose but not act: setup, pause and replay are not registered, and hookdeck_issues can list and inspect but not acknowledge, resolve or dismiss."
          }
        }
      },
      "transport": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "cli",
              "http",
              "none"
            ],
            "default": "none",
            "description": "cli supervises a `hookdeck listen` child per route (zero ingress, but a CLI destination is not durable while disconnected). http expects a reachable Gateway and gives the full reliability stack. none leaves transport to the operator."
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 18789,
            "description": "Gateway port the CLI forwards to."
          },
          "binaryPath": {
            "type": "string",
            "minLength": 1,
            "default": "hookdeck",
            "description": "Resolved explicitly on PATH, because a shadowed binary defeats the version gate."
          },
          "allowUnsupportedVersion": {
            "type": "boolean",
            "default": false,
            "description": "Downgrade the >=2.4.0 gate to a warning. Versions below 2.3.2 silently stop delivering after a session expires."
          },
          "publicUrl": {
            "type": "string",
            "format": "uri",
            "description": "Public base URL of the Gateway, required for http transport provisioning."
          },
          "cliConfigPath": {
            "type": "string",
            "description": "Where the Hookdeck CLI keeps its session, used by hookdeck_doctor to check that the CLI and the API key point at the same project. Defaults to ~/.config/hookdeck/config.toml."
          }
        }
      }
    }
  }
}
