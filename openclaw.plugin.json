{
  "id": "hookdeck",
  "name": "Hookdeck",
  "description": "Reliable webhooks for OpenClaw. Verified, deduplicated and retryable event delivery via the Hookdeck Event Gateway.",
  "activation": {
    "onStartup": true
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "signingSecret",
          "expected": "string",
          "ownerKind": "plugin"
        },
        {
          "path": "routes.*.signingSecret",
          "expected": "string",
          "ownerKind": "route"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "headerPrefix": {
        "type": "string",
        "minLength": 1,
        "default": "x-hookdeck",
        "description": "Prefix for Hookdeck's delivery headers. White-labelable per Hookdeck project, so read from config rather than assumed."
      },
      "signingSecret": {
        "description": "Default Hookdeck signing secret (Settings -> Project -> Secrets). Routes may override.",
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "provider",
              "id"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec"
                ]
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "apiKey": {
        "description": "Hookdeck API key. Optional \u2014 without it the plugin runs ingress-only: verification, deduplication and dispatch all work, but work interrupted by a crash cannot be re-queued.",
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "provider",
              "id"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec"
                ]
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "ingress": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "basePath": {
            "type": "string",
            "minLength": 1,
            "default": "/hookdeck",
            "description": "Gateway route prefix. May not be '/'."
          }
        }
      },
      "maxConcurrent": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 4,
        "description": "Local admission control. In CLI transport this is the only limit, since CLI destinations carry no rate_limit field."
      },
      "busyRetryAfterSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 10,
        "description": "Retry-After sent when deferring a delivery at capacity."
      },
      "dedupe": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ttlHours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 720,
            "default": 168,
            "description": "Ledger retention. Must exceed Hookdeck's one-week automatic retry ceiling."
          }
        }
      },
      "storage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Persist the ledger and dead-letter log under the plugin state directory. Off means memory-only: exactly-once within a process, at-least-once across a restart, and no crash recovery."
          },
          "deadLetterMaxEntries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "default": 500,
            "description": "Dead-letter entries retained before the oldest are dropped."
          }
        }
      },
      "recovery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "On startup, re-queue work interrupted by a crash by calling POST /events/{id}/retry for every running ledger row owned by a dead process instance. Requires apiKey."
          },
          "maxEvents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 50,
            "description": "Caps a crash loop from storming the Hookdeck API. Oldest events are recovered first."
          }
        }
      },
      "safety": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowRetryCancel": {
            "type": "boolean",
            "default": false,
            "description": "Permit 'Retry-After: -1' to cancel Hookdeck's automatic retries on permanently-invalid input. Off by default: with it off, wire behaviour matches the sibling Hermes and n8n plugins exactly."
          }
        }
      },
      "routes": {
        "type": "object",
        "description": "Map of routeId -> route. Each route is served at <ingress.basePath>/<path>.",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "dispatch"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "path": {
              "type": "string",
              "description": "Path segment appended to ingress.basePath. Defaults to '/<routeId>'."
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "Hookdeck source name. Required \u2014 'hookdeck listen' takes it as a positional argument and forwards exactly one source per process."
            },
            "signingSecret": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "provider",
                    "id"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": [
                        "env",
                        "file",
                        "exec"
                      ]
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "dispatch": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "sessionKey"
                  ],
                  "properties": {
                    "mode": {
                      "const": "wake"
                    },
                    "sessionKey": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Session the system event is enqueued against. Required \u2014 enqueueSystemEvent throws without one."
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "description": "System event text. Placeholders: {source}, {eventId}, {routeId}."
                    },
                    "wakeMode": {
                      "type": "string",
                      "enum": [
                        "now",
                        "next-heartbeat"
                      ],
                      "default": "now",
                      "description": "'now' also requests an immediate heartbeat; 'next-heartbeat' only enqueues."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "sessionKey"
                  ],
                  "properties": {
                    "mode": {
                      "const": "taskflow"
                    },
                    "sessionKey": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Session the flows are bound to. Flow state is scoped to it."
                    },
                    "controllerId": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Identifies flows this route manages. Defaults to hookdeck/<routeId>."
                    },
                    "allowedActions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "enum": [
                          "get_flow",
                          "list_flows",
                          "find_latest_flow",
                          "resolve_flow",
                          "get_task_summary",
                          "create_flow",
                          "run_task",
                          "set_waiting",
                          "resume_flow",
                          "finish_flow",
                          "fail_flow",
                          "request_cancel",
                          "cancel_flow"
                        ]
                      },
                      "description": "When set, only these actions are accepted on this route."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "sessionKey",
                    "prompt"
                  ],
                  "properties": {
                    "mode": {
                      "const": "agent"
                    },
                    "sessionKey": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Supports {routeId}, {eventId}, {source}; sanitised to a safe alphabet."
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Prompt template. Placeholders such as {{payload.type}} are substituted as JSON, never as bare prose, so a payload cannot break out into instruction position."
                    },
                    "ackMode": {
                      "type": "string",
                      "enum": [
                        "async_retry",
                        "sync"
                      ],
                      "default": "async_retry",
                      "description": "async_retry acknowledges 202 and runs in the background, asking Hookdeck to redeliver on failure. sync holds the response, degrading to 202 on timeout."
                    },
                    "syncTimeoutSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3600,
                      "default": 45
                    },
                    "maxAgentRetries": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 50,
                      "default": 3,
                      "description": "Redeliveries requested after a failed run before the event is marked exhausted."
                    },
                    "deliver": {
                      "type": "boolean",
                      "default": false,
                      "description": "Whether the agent's reply is delivered to a messaging channel. Off by default: a webhook-triggered route must not send anything outbound, or an injected payload gains a way out."
                    },
                    "lane": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "filters": {
              "type": "array",
              "description": "Payload filters; all must pass. A non-match is answered 200, since the drop is deliberate. Prefer filtering at the Hookdeck connection where you can.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Dotted path into the payload."
                  },
                  "equals": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "in": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "exists": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
